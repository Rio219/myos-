/* =====================================
        Rofi Theme: Haku Theme :>
 =======================================*/

@import "../../.local/state/haku_theme/rofi-style.rasi"

/* ===== GLOBAL VARIABLES ===== */
* {
    background:          rgba(0, 0, 0, 0.7);
    foreground:          #dfdfdf;
    modebar-bg:          rgba(27, 27, 27, 0.5);
    background-color:    transparent;
    text-color:          @foreground;
    
    margin:              0;
    padding:             0;
    spacing:             0;
}

/* ===== MAIN WINDOW ===== */
window {
    width:               30%;
    height:              45%;
    background-color:    @background;
    border-radius:       16px;
    padding:             14px;
}

mainbox {
    spacing:             12px;
    children:            [ inputbar, mode-switcher, listview ];
}

/* ===== INPUT BAR ===== */
inputbar {
    padding:             6px 10px;
    background-color:    rgba(0, 0, 0, 0.25);
    border-radius:       12px;
    children:            [ prompt, entry ];
}

prompt {
    padding:             6px 12px;
    background-color:    @accent;
    text-color:          @background;
    border-radius:       10px;
    font-weight:         bold;
}

entry {
    padding:             6px 10px;
    text-color:          @accent;
    placeholder:         "󱎸 Search...";
    placeholder-color:   rgba(223, 223, 223, 0.4);
}

/* ===== MODE SWITCHER (Apps/Run/Window) ===== */
mode-switcher {
    margin:              0px 4px;
    padding:             4px;
    background-color:    @accent;
    border-radius:       12px;
    spacing:             6px;
}

button {
    padding:             5px 12px;
    border-radius:       10px;
    background-color:    transparent;
    text-color:          @background;
}

button selected {
    background-color:    @background;
    text-color:          @accent;
}

/* ===== LISTVIEW ===== */
listview {
    margin:              0px 0px 4px 0px;
    scrollbar:           true;
    cycle:               true;
    dynamic:             true;
}

/* ===== ELEMENTS ===== */
element {
    padding:             8px 10px;
    margin:              2px 4px;
    border-radius:       10px;
    orientation:         horizontal;
    vertical-align:      0.5; 
}

element-icon {
    size:                22px;
    margin:              0 10px 0 0;
    vertical-align:      0.5;
}

element-text {
    text-color:          @accent;
    vertical-align:      0.5;
}

/* ===== ELEMENT STATES ===== */
element selected {
    background-color:    @accent;
}

element-text selected {
    text-color:          @background;
}

element-icon selected {
    background-color:    transparent; 
}

/* ===== SCROLLBAR ===== */
scrollbar {
    handle-width:           5px;
    handle-color:           @accent;
    handle-rounded-corners: true;
    padding:                0px 0px 0px 4px;
}