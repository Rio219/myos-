{
    // ==========================================
    // Giao diện & Thẩm mỹ: Cứng cáp, Tương phản cao
    // ==========================================
    "workbench.colorTheme": "One Dark Pro Darker",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.productIconTheme": "Default",
    "window.titleBarStyle": "custom",
    "window.dialogStyle": "custom",
    "window.menuBarVisibility": "compact",
    "workbench.layoutControl.enabled": true,
    "workbench.tree.indent": 18,
    "workbench.tree.renderIndentGuides": "always",

    // Tăng độ tương phản, nền đen sâu thẳm & Viền ngăn cách cứng cáp
    "workbench.colorCustomizations": {
        "editor.background": "#0d1117",
        "sideBar.background": "#090d12",
        "sideBar.border": "#30363d",
        "activityBar.background": "#06090c",
        "activityBar.border": "#30363d",
        "titleBar.activeBackground": "#06090c",
        "titleBar.border": "#30363d",
        "tab.activeBackground": "#0d1117",
        "tab.inactiveBackground": "#06090c",
        "tab.border": "#30363d",
        "tab.activeBorderTop": "#58a6ff",
        "editorGroup.border": "#30363d",
        "panel.background": "#090d12",
        "panel.border": "#30363d",
        "statusBar.background": "#06090c",
        "statusBar.border": "#30363d"
    },

    // ==========================================
    // Font chữ & Nét gõ: Đậm đà, sắc nét (JetBrains Mono)
    // ==========================================
    "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', Consolas, monospace",
    "editor.fontSize": 14.5,
    "editor.lineHeight": 1.6,
    "editor.fontLigatures": true,
    "editor.fontWeight": "500", // Tăng độ đậm để chữ nét căng, không bị nhạt
    "editor.letterSpacing": 0.4,

    // Hiệu ứng con trỏ & Cuộn mượt
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorStyle": "line",
    "editor.cursorWidth": 3,
    "editor.smoothScrolling": true,
    "workbench.list.smoothScrolling": true,

    // Cặp ngoặc & Gióng hàng rõ nét
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.guides.indentation": true,
    "editor.guides.highlightActiveIndentation": true,

    // Sticky Scroll (Ghim tên hàm/class)
    "editor.stickyScroll.enabled": true,
    "editor.stickyScroll.maxLineCount": 5,

    // ==========================================
    // Định dạng & Tự động lưu
    // ==========================================
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "files.autoSave": "onFocusChange",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,

    // ==========================================
    // Terminal tích hợp trong VS Code
    // ==========================================
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', monospace",
    "terminal.integrated.fontSize": 13.5,
    "terminal.integrated.fontWeight": "500",
    "terminal.integrated.lineHeight": 1.3,
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.defaultProfile.linux": "fish",

    // ==========================================
    // Hiệu năng & Bố cục gọn gàng
    // ==========================================
    "editor.minimap.enabled": false,
    "git.autofetch": true,
    "git.enableSmartCommit": true,
    "explorer.compactFolders": true,
    "workbench.editor.pinnedTabsOnSeparateRow": true,
    "breadcrumbs.enabled": true
}
