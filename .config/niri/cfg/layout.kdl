layout {
    gaps 14
    center-focused-column "never"

    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#55555566"
        inactive-color "#1c1c1c33"
    }

    border {
        off
    }

    shadow {
        on
        draw-behind-window true
        softness 24
        spread 4
        offset x=0 y=4
        color "#00000066"
    }

    struts {
        left 8
        right 8
        top 8
        bottom 8
    }
}
